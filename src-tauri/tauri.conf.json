{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "2048",
  "mainBinaryName": "2048",
  "version": "0.1.0",
  "identifier": "com.gridline.game2048",
  "build": {
    "frontendDist": ["../2048.html"]
  },
  "app": {
    "windows": [
      {
        "title": "2048",
        "url": "2048.html",
        "width": 720,
        "height": 1040,
        "minWidth": 420,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
